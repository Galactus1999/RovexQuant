# Local development uses SQLite. Hosted Docker defaults to PostgreSQL and must not
# silently fall back to an ephemeral filesystem.
QUANT_TOKEN_STORAGE_MODE=sqlite
QUANT_TOKEN_DB_PATH=./quant-secrets.sqlite3
QUANT_TOKEN_DATABASE_URL=
QUANT_TOKEN_MIGRATION_DATABASE_URL=
QUANT_TOKEN_DATABASE_SSLMODE=require

# Market-data gateway: server-side only. Never put these values in Android or Git.
QUANT_MARKET_GATEWAY_TOKEN=
# Private mobile-app login; use a long unique password and rotate the signing key to revoke sessions.
QUANT_APP_USERNAME=
QUANT_APP_PASSWORD=
QUANT_APP_SESSION_SIGNING_KEY=
QUANT_APP_SESSION_TTL_SECONDS=14400
# Fernet key for the encrypted provider-token vault.
QUANT_TOKEN_ENCRYPTION_KEY=
QUANT_ADMIN_GATEWAY_TOKEN=
# Personal Upstox read-only Analytics Token (1-year validity).
UPSTOX_ANALYTICS_TOKEN=
# Optional Dhan account. Dhan Data API entitlement/pricing applies separately.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# TejHQ free key: required for AI strategy recovery's corporate-action-adjusted EOD prices and delivery history (1,000 calls/day).
# Keyless raw OHLCV, EOD snapshots and corporate actions remain available without a key, but are not used for strategy recovery.
TEJHQ_API_KEY=
TEJHQ_BASE_URL=https://api.tejhq.dev

# Legacy server-to-server AI routes use this gateway token. Mobile /api/v1/app/ai routes use the short-lived Quant app session and do not require this token.
# Provider API keys and model defaults remain server-side. Never put these values in the Android app, repository, logs or client configuration.
QUANT_AI_GATEWAY_TOKEN=
GROQ_API_KEY=
GROQ_API_KEYS_JSON=
GROQ_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS_JSON=
DEEPSEEK_DEFAULT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS_JSON=
OPENROUTER_DEFAULT_MODEL=
GEMINI_API_KEY=
GEMINI_API_KEYS_JSON=
GEMINI_DEFAULT_MODEL=
OPENAI_API_KEY=
OPENAI_API_KEYS_JSON=
OPENAI_DEFAULT_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Quant

# Optional model IDs used only when that provider is selected as a fallback.
DEEPSEEK_FALLBACK_MODEL=
GROQ_FALLBACK_MODEL=
OPENROUTER_FALLBACK_MODEL=
GEMINI_FALLBACK_MODEL=
OPENAI_FALLBACK_MODEL=
